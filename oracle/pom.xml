<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.subapavel.jqj</groupId>
    <artifactId>jqj-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oracle</artifactId>
  <name>oracle</name>

  <!-- Tests only: the oracle runs the code of every module (ADR-0014). -->
  <dependencies>
    <dependency>
      <groupId>io.github.subapavel.jqj</groupId>
      <artifactId>query-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.subapavel.jqj</groupId>
      <artifactId>jq-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.subapavel.jqj</groupId>
      <artifactId>jq-cli</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Coverage of query-core and jq-core from every test in the reactor (ADR-0014). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- ./mvnw -pl oracle -am test pitest:mutationCoverage: mutates the upstream modules (ADR-0014). -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <crossModule>true</crossModule>
          <additionalClasspathElements>
            <additionalClasspathElement>${project.basedir}/../query-core/target/test-classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../jq-core/target/test-classes</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
