# G2 (Gates.G2At1k): select and construct, compact, on the orders 1k document of bench/G1.1k.
case bench/G2.1k
arg -c
filter .orders[] | select(.total > 100) | {id, total}
stdin {"orders":[{"id":0,"total":0.13,"k":"k0"},{"id":1,"total":79.32,"k":"k1"},{"id":2,"total":158.51,"k":"k2"},{"id":3,"total":37.7,"k":"k3"},{"id":4,"total":116.89,"k":"k4"},{"id":5,"total":196.08,"k":"k5"},{"id":6,"total":75.27,"k":"k6"},{"id":7,"total":154.46,"k":"k7"},{"id":8,"total":33.65,"k":"k8"},{"id":9,"total":112.84,"k":"k9"},{"id":10,"total":192.03,"k":"k10"},{"id":11,"total":71.22,"k":"k11"},{"id":12,"total":150.41,"k":"k12"},{"id":13,"total":29.6,"k":"k13"},{"id":14,"total":108.79,"k":"k14"},{"id":15,"total":187.98,"k":"k15"}],"items":[{"sku":"s0","price":1},{"sku":"s1","price":4731},{"sku":"s2","price":9461},{"sku":"s3","price":4192},{"sku":"s4","price":8922},{"sku":"s5","price":3653},{"sku":"s6","price":8383},{"sku":"s7","price":3114},{"sku":"s8","price":7844},{"sku":"s9","price":2575},{"sku":"s10","price":7305},{"sku":"s11","price":2036},{"sku":"s12","price":6766},{"sku":"s13","price":1497},{"sku":"s14","price":6227},{"sku":"s15","price":958}],"a":{"b":{"c":"x"}}}                                 \n
end

# G3 (Gates.G3At100k / G3At10m, F-33): ADR-0019 gives G3 no 1 KB cell, so the case runs Inputs.recs(Size.K1), the
# 1 024-byte recs document (ADR-0023), copied byte for byte.
case bench/G3.1k
arg -c
filter group_by(.k) | map({k: .[0].k, n: length})
stdin [{"k":"k46","v":276794},{"k":"k6","v":658126},{"k":"k35","v":239947},{"k":"k19","v":470300},{"k":"k32","v":573620},{"k":"k27","v":823905},{"k":"k56","v":451023},{"k":"k53","v":165584},{"k":"k40","v":418738},{"k":"k41","v":91533},{"k":"k53","v":392766},{"k":"k27","v":477319},{"k":"k29","v":774085},{"k":"k54","v":917998},{"k":"k25","v":790741},{"k":"k24","v":674259},{"k":"k62","v":400421},{"k":"k53","v":581980},{"k":"k8","v":804123},{"k":"k13","v":558496},{"k":"k18","v":210744},{"k":"k47","v":995109},{"k":"k55","v":499617},{"k":"k2","v":56627},{"k":"k43","v":957643},{"k":"k3","v":469268},{"k":"k24","v":662465},{"k":"k4","v":607531},{"k":"k9","v":668373},{"k":"k39","v":947439},{"k":"k7","v":745377},{"k":"k5","v":296450},{"k":"k26","v":713145},{"k":"k25","v":244594},{"k":"k33","v":945071},{"k":"k33","v":301771},{"k":"k15","v":136321},{"k":"k8","v":831254},{"k":"k15","v":251491},{"k":"k59","v":276915},{"k":"k13","v":84325},{"k":"k37","v":918030},{"k":"k1","v":693826},{"k":"k21","v":242881},{"k":"k29","v":411652}]\n
