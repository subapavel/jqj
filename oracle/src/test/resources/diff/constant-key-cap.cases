2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,1]
stdin null\n
end

# Deviation: every fold of a compile shares 1 MiB of bytes built (ADR-0035, bd34167). The first key's check builds
# 1048540 bytes, so the second key is left to the run; the compile still fails on the first, with one error, not two

case constant-key-cap/check-after-the-compile-budget
deviation huge-constant-keys
arg -c
filter {(("x"*21394)/"x"):1},{(("x"*5000)/"x"):1}
stdin null\n
jqj-rc 3
jqj-stderr jq: error: Cannot use array (["","","","","","","","",...]) as object key at <top-level>, line 1, column 3:\n    {(("x"*21394)/"x"):1},{(("x"*5000)/"x"):1}\n      ^^^^^^^^^^^^^^^\njq: 1 compile error\n
end

# Deviation: jq checks a key at parse time wherever it stands; past the compile budget jqj leaves it to the run, which
# never reaches a key behind empty, so the filter gives its other output, rc 0 (DEVIATIONS "Huge constant keys")

case constant-key-cap/unreached-huge-key
deviation huge-constant-keys
arg -c
filter 1, (empty | {(("x"*2000000)/"x"):1})
stdin null\n
jqj-rc 0
jqj-stdout 1\n
jqj-stderr
end
