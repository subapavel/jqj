# #85: 16 keys of four blocks, each Aa or BB, key i's block b BB when bit b of i is set: one hash under a 31-polynomial
# of the bytes (String.hashCode's), so a hash proof probes past its budget and sorts them (ADR-0044). Then twice more,
# the first and a middle key repeated at the end.

case distinct/colliding16-iterate
arg -c
filter .[]
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15}\n
end

case distinct/colliding16-dot
arg -c
filter .
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15}\n
end

case distinct/colliding16-keys
arg -c
filter keys
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15}\n
end

case distinct/colliding16-to-entries
arg -c
filter to_entries
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15}\n
end

case distinct/colliding16-repeat-iterate
arg -c
filter .[]
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15,"AaAaAaAa":16,"BBBBBBAa":17}\n
end

case distinct/colliding16-repeat-dot
arg -c
filter .
stdin {"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15,"AaAaAaAa":16,"BBBBBBAa":17}\n
end

# #85: to_entries becomes a native (ADR-0044, amending ADR-0042): an array's indices as keys, the errors of the kinds
# that have no keys, and a read object's repeat at its first place with its last value.

case distinct/to-entries-array
arg -c
filter to_entries
stdin [10,20]\n
end

case distinct/to-entries-null
arg -c
filter to_entries
stdin null\n
end

case distinct/to-entries-number
arg -c
filter to_entries
stdin 1\n
end

case distinct/to-entries-repeat
arg -c
filter to_entries
stdin {"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k0":9}\n
end

# #85: the other walkers of ADR-0044 on 9 keys and a repeat of the first: length, object + on either side, and == on
# either side, against the object it reads as and the one it would be if the first value won.

case distinct/repeat-length
arg -c
filter length
stdin {"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k0":9}\n
end

case distinct/repeat-plus
arg -c
filter [. + {"k9":10}, {"z":-1} + .]
stdin {"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k0":9}\n
end

case distinct/repeat-equal
arg -c
filter [. == {"k0":9,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8}, {"k0":9,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8} == ., . == {"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8}]
stdin {"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k0":9}\n
end
