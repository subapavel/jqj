# Differential cases (ADR-0020) of #95, Equality's key index (ADR-0044 as amended by #95): == and != take a
# read right side through its key proof, one lookup per left key among the pairwise proof's pairs (8 keys or
# fewer), in its table or by a search of its sorted keys (keys of Aa/BB blocks, which share one hash). The
# objects are reordered copies, with a repeated key whose last value wins, a missing last key, nested wide
# objects, a built side, and unique, group_by and index, which compare objects by equality. Format:
# oracle/src/main/java/io/github/subapavel/jqj/oracle/diff/DiffCase.java. Expected outputs live in
# key-index.rec, written by scripts/oracle-record.sh only. Ids are immutable.

# 20 keys each, the second side reversed: past the 8 pairwise keys, so the table.
case key-index/reordered-wide
arg -c
filter .[0] == .[1], .[1] == .[0]
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0}]\n
end

# 16 keys of Aa/BB blocks share one hash, so the proof sorts and a lookup searches the sorted keys.
case key-index/reordered-colliding
arg -c
filter .[0] == .[1], .[1] == .[0]
stdin [{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15},{"BBBBBBBB":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0}]\n
end

# 3 keys each: the pairwise proof.
case key-index/reordered-pairwise
arg -c
filter .[0] == .[1]
stdin [{"a":1,"b":2,"c":3},{"c":3,"a":1,"b":2}]\n
end

# The left side's last key, k19, is the one the right side lacks: one length, one count.
case key-index/miss-last-key
arg -c
filter .[0] == .[1], .[1] == .[0]
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"x19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0}]\n
end

# The sorted path: the left side's last key, BBBBBBBB, is missing on the right.
case key-index/miss-last-key-colliding
arg -c
filter .[0] == .[1]
stdin [{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15},{"BBBBBBBA":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0}]\n
end

case key-index/miss-pairwise
arg -c
filter .[0] == .[1]
stdin [{"a":1,"b":2},{"b":2,"c":1}]\n
end

# One key fewer on the right: every right key is found, then the left side's twentieth is not.
case key-index/fewer-right-keys
arg -c
filter .[0] == .[1], .[1] == .[0]
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18}]\n
end

# A repeated key on the right compares by its last value.
case key-index/repeat-last-wins
arg -c
filter .[0] == .[1], .[0] == .[2]
stdin [{"a":1,"b":2},{"b":2,"a":0,"a":1},{"a":1,"b":2,"a":0}]\n
end

# The table with repeats: k3 and k19 again, each last with its own value; then k3 last with another.
case key-index/repeat-last-wins-wide
arg -c
filter .[0] == .[1], .[1] == .[0], .[0] == .[2]
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"k19":0,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0,"k3":99,"k3":3,"k19":19},{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0,"k3":99}]\n
end

# The sorted path with repeats: AaAaAaAa again, last with its own value, then with another.
case key-index/repeat-last-wins-colliding
arg -c
filter .[0] == .[1], .[0] == .[2]
stdin [{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15},{"BBBBBBBB":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0,"AaAaAaAa":7,"AaAaAaAa":0},{"BBBBBBBB":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0,"AaAaAaAa":7}]\n
end

# Tag-6 keys: an escaped a repeats a by its decoded bytes, and the last of the two wins.
case key-index/repeat-escaped
arg -c
filter .[0] == .[1], .[0] == .[2]
stdin [{"a":1,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8},{"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"a":0,"\\u0061":1},{"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"\\u0061":1,"a":0}]\n
end

