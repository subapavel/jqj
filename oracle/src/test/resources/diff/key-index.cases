case key-index/read-left-built-right
arg -c
filter .[0] == (.[1] | with_entries(.)), .[0] == (.[1] | del(.k0))
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0}]\n
end

# != over the same pairs: a reordered copy, a missing last key, a built left side, a value against itself.
case key-index/not-equal
arg -c
filter .[0] != .[1], .[0] != .[2], .[1] != .[0], (.[0] | with_entries(.)) != .[2], .[0] != .[0]
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0},{"x19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0}]\n
end

case key-index/not-equal-colliding
arg -c
filter .[0] != .[1], .[0] != .[2]
stdin [{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15},{"BBBBBBBB":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0},{"BBBBBBBA":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0}]\n
end

# unique keeps one of each group of equal objects.
case key-index/unique-objects
arg -c
filter unique
stdin [{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},{"x19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0},{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0},{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15}]\n
end

# group_by on an object key: the equal ones in one group.
case key-index/group-by-object
arg -c
filter group_by(.o) | map(length)
stdin [{"o":{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},"i":0},{"o":{"AaAaAaAa":0,"BBAaAaAa":1,"AaBBAaAa":2,"BBBBAaAa":3,"AaAaBBAa":4,"BBAaBBAa":5,"AaBBBBAa":6,"BBBBBBAa":7,"AaAaAaBB":8,"BBAaAaBB":9,"AaBBAaBB":10,"BBBBAaBB":11,"AaAaBBBB":12,"BBAaBBBB":13,"AaBBBBBB":14,"BBBBBBBB":15},"i":1},{"o":{"k19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0},"i":2},{"o":{"x19":19,"k18":18,"k17":17,"k16":16,"k15":15,"k14":14,"k13":13,"k12":12,"k11":11,"k10":10,"k9":9,"k8":8,"k7":7,"k6":6,"k5":5,"k4":4,"k3":3,"k2":2,"k1":1,"k0":0},"i":3},{"o":{"BBBBBBBB":15,"AaBBBBBB":14,"BBAaBBBB":13,"AaAaBBBB":12,"BBBBAaBB":11,"AaBBAaBB":10,"BBAaAaBB":9,"AaAaAaBB":8,"BBBBBBAa":7,"AaBBBBAa":6,"BBAaBBAa":5,"AaAaBBAa":4,"BBBBAaAa":3,"AaBBAaAa":2,"BBAaAaAa":1,"AaAaAaAa":0},"i":4},{"o":{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19},"i":5}]\n
