# P3: a start after the end, both in range.

case slice/array-start-after-end
arg -c
filter .a[.s:.e]
stdin {"a":[0,1,2,3,4],"s":3,"e":1}\n
end

case slice/string-start-after-end
arg -c
filter .a[.s:.e]
stdin {"a":"é𝄞é𝄞é","s":3,"e":1}\n
end

# P3: an object or array key .[k]. An array key on an array is jv_array_indexes, a Stub owned by #72 (not
# required by #63).

case slice/key-start-end-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":{"start":1,"end":2}}\n
end

case slice/key-start-end-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":{"start":1,"end":2}}\n
end

case slice/key-start-only-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":{"start":1}}\n
end

case slice/key-start-only-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":{"start":1}}\n
end

case slice/key-empty-object-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":{}}\n
end

case slice/key-empty-object-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":{}}\n
end

case slice/key-bad-start-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":{"start":"x","end":2}}\n
end

case slice/key-bad-start-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":{"start":"x","end":2}}\n
end

case slice/key-array-one-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":[1]}\n
end

case slice/key-array-one-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":[1]}\n
end

case slice/key-array-empty-on-array
arg -c
filter .a[.k]
stdin {"a":[0,1,2,1],"k":[]}\n
end

case slice/key-array-empty-on-string
arg -c
filter .a[.k]
stdin {"a":"abc","k":[]}\n
end

# P4: bounds beyond an int on an object.

case slice/big-bounds-on-object
arg -c
filter .[100000000000:200000000000]
stdin {}\n
end

# P5: the bounds nest a outside b (ADR-0034), and the first bound's error comes first.

case slice/order-bounds
arg -c
filter .[(0,1):(2,3)]
stdin [0,1,2,3]\n
end

case slice/scope-bound-error-first
arg -c
filter .[.a:.b]
stdin "s"\n
end

# P1: an array a slice builds (a BuiltArray, decision 1 of the #63 approval) under each navigation step, pretty and
# in an error.

case slice/built-index
arg -c
filter .[1:] | .[0]
stdin [0,1,2,3]\n
end

case slice/built-index-negative
arg -c
filter .a[1:][.k]
stdin {"a":[0,1,2,3],"k":-1}\n
end

case slice/built-index-past-end
arg -c
filter .[1:] | .[3]
stdin [0,1,2,3]\n
end

case slice/built-slice
arg -c
filter .[1:] | .[1:2]
stdin [0,1,2,3]\n
end

case slice/built-slice-negative
arg -c
filter .a[1:][.s:]
stdin {"a":[0,1,2,3],"s":-2}\n
end

case slice/built-iterate
arg -c
filter .[1:] | .[]
stdin [0,[1],{"a":2},"x"]\n
end

case slice/built-iterate-postfix
arg -c
filter .[1:][]
stdin [0,[1],{"a":2},"x"]\n
end

case slice/built-iterate-empty
arg -c
filter .[9:] | .[]
stdin [0,1]\n
end

case slice/built-element-slice
arg -c
filter .[1:] | .[0][1:]
stdin [0,"abc"]\n
end

case slice/built-pretty
filter .[1:]
stdin [0,[1,2],{"a":[]},"x"]\n
end

case slice/built-pretty-empty
filter .[9:]
stdin [0,1]\n
end

case slice/built-field-error
arg -c
filter .[1:] | .a
stdin [0,1]\n
end

# P2: a bound or key that is neither null nor a number: an error, and with ? no result, the run going on.

case slice/bad-start-on-array
arg -c
filter .["a":]
stdin [1,2]\n
end

case slice/bad-end-on-array
arg -c
filter .[:"b"]
stdin [1,2]\n
end

case slice/quiet-bad-start-on-array
arg -c
filter .["a":]?
stdin [1,2]\n
end

case slice/quiet-bad-end-on-array
arg -c
filter .[:"b"]?
stdin [1,2]\n
end

case slice/quiet-bad-start-on-string
arg -c
filter .["a":]?
stdin "abc"\n
end

case slice/quiet-bad-then-more
arg -c
filter .["a":]?, 1
stdin [1,2]\n
end

case slice/quiet-bad-bound-from-input
arg -c
filter .a[.s:]?
stdin {"a":[1,2],"s":"x"}\n
end

case slice/quiet-key-bad-start-on-array
arg -c
filter .a[.k]?
stdin {"a":[0,1,2],"k":{"start":"x","end":2}}\n
end

# P2: a bound of each other kind: a boolean, an array, an object.

case slice/bound-true-on-array
arg -c
filter .[true:2]
stdin [1,2,3]\n
end

case slice/bound-array-on-array
arg -c
filter .a[.k:2]
stdin {"a":[1,2,3],"k":[1]}\n
end

case slice/bound-object-on-array
arg -c
filter .a[:.k]
stdin {"a":[1,2,3],"k":{}}\n
end

case slice/bound-true-on-string
arg -c
filter .[true:2]
stdin "abc"\n
end

