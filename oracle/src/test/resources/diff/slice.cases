# Differential cases (ADR-0020) of #63: the slice .[a:b], its quiet variant and the object key {"start","end"};
# format: oracle/src/main/java/io/github/subapavel/jqj/oracle/diff/DiffCase.java. Expected outputs live in slice.rec,
# written by scripts/oracle-record.sh only. Ids are immutable. Every case uses -c but slice/built-pretty and
# slice/built-pretty-empty, which print a BuiltArray indented.

# P1: each form on each kind (null true 1 "abc" [1] {"a":1}).

case slice/one-two-null
arg -c
filter .[1:2]
stdin null\n
end

case slice/one-two-true
arg -c
filter .[1:2]
stdin true\n
end

case slice/one-two-number
arg -c
filter .[1:2]
stdin 1\n
end

case slice/one-two-string
arg -c
filter .[1:2]
stdin "abc"\n
end

case slice/one-two-array
arg -c
filter .[1:2]
stdin [1]\n
end

case slice/one-two-object
arg -c
filter .[1:2]
stdin {"a":1}\n
end

case slice/to-two-null
arg -c
filter .[:2]
stdin null\n
end

case slice/to-two-true
arg -c
filter .[:2]
stdin true\n
end

case slice/to-two-number
arg -c
filter .[:2]
stdin 1\n
end

case slice/to-two-string
arg -c
filter .[:2]
stdin "abc"\n
end

case slice/to-two-array
arg -c
filter .[:2]
stdin [1]\n
end

case slice/to-two-object
arg -c
filter .[:2]
stdin {"a":1}\n
end

case slice/string-from-null
arg -c
filter .["x":]
stdin null\n
end

case slice/string-from-true
arg -c
filter .["x":]
stdin true\n
end

case slice/string-from-number
arg -c
filter .["x":]
stdin 1\n
end

case slice/string-from-string
arg -c
filter .["x":]
stdin "abc"\n
end

case slice/string-from-array
arg -c
filter .["x":]
stdin [1]\n
end

case slice/string-from-object
arg -c
filter .["x":]
stdin {"a":1}\n
end

case slice/one-from-quiet-null
arg -c
filter .[1:]?
stdin null\n
end

case slice/one-from-quiet-true
arg -c
filter .[1:]?
stdin true\n
end

case slice/one-from-quiet-number
arg -c
filter .[1:]?
stdin 1\n
end

case slice/one-from-quiet-string
arg -c
filter .[1:]?
stdin "abc"\n
end

case slice/one-from-quiet-array
arg -c
filter .[1:]?
stdin [1]\n
end

case slice/one-from-quiet-object
arg -c
filter .[1:]?
stdin {"a":1}\n
end

# P3: every pair of bounds s and e from the input (null, fractions, negatives, beyond the length, 1e300, NaN),
# on an array of 5 and on a string of 5 code points (e-acute and U+1D11E, 2 and 4 bytes).

