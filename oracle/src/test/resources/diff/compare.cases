# Differential cases (ADR-0020) of #66 "S2a.16 Comparison and sort order": the six comparison operators over jq
# 1.8.2's value order (jv_cmp, ADR-0037, GLOSSARY "Value order"), the right operand as the outer loop (ADR-0034
# amendment for #65, ADR-0037), and the parse-time fold of a comparison of two constants as an object key (ADR-0036,
# ADR-0037: and, or and // are not folded). The depth boundaries are compare-depth.cases; and, or and not are
# logic.cases; // is alternative.cases. A case named nan-* computes NaN with #65's arithmetic; the NaN rows belong to
# #72 (#66 design approval, O4), so none is required at #66 (require/66.txt). Format: oracle/src/main/java/io/github/
# subapavel/jqj/oracle/diff/DiffCase.java. Expected outputs live in compare.rec, written by scripts/oracle-record.sh
# only. Ids are immutable.

# kind order and every operator on every kind pair: 7 x 7 results, the right operand outer

case compare/kinds-less
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) < (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-less-or-equal
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) <= (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-greater
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) > (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-greater-or-equal
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) >= (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-equal
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) == (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-not-equal
arg -c
filter [(null, false, true, 1, "a", [1], {"a":1}) != (null, false, true, 1, "a", [1], {"a":1})]
stdin null\n
end

case compare/kinds-from-the-document
arg -c
filter [.[] < .[]]
stdin [null,false,true,0,"",[],{}]\n
end

# lowering: the right operand is the outer loop; the left-outer order gives [true,true,false,true]

case compare/right-operand-outer-less
arg -c
filter [(1,2) < (2,3)]
stdin null\n
end

case compare/right-operand-outer-not-equal
arg -c
filter [(1,2) != (2,3)]
stdin null\n
end

case compare/right-operand-outer-greater-or-equal
arg -c
filter [(1,2) >= (2,3)]
stdin null\n
end

case compare/right-operand-outer-error
arg -c
filter [(1, .a) < (2, .[0])]
stdin "s"\n
end

case compare/identity-operands
arg -c
filter [. < ., . <= ., . == ., . != ., . > ., . >= .]
stdin [1,{"a":"b"}]\n
end

case compare/constant-and-identity
arg -c
filter [. < 2, 2 < ., . == 1, 1 != .]
stdin 1\n
end

# strings: unsigned UTF-8 bytes, then length

case compare/strings-bytes-then-length
arg -c
filter ["a" < "b", "a" < "aa", "" < "a", "Z" < "a", "ab" < "abc", "abc" > "ab", "" == "", "a" <= "a"]
stdin null\n
end

case compare/strings-unsigned-bytes
arg -c
filter ["a" < "\\u0080", "\\u007f" < "\\u0080", "\\u00ff" < "\\u0100", "é" > "z"]
stdin null\n
end

case compare/strings-utf8-not-utf16
arg -c
filter ["\\ufffd" < "\\ud83d\\ude00", "\\ue000" < "\\ud800\\udc00", "😀" > "\\uffff"]
stdin null\n
end

case compare/strings-from-the-document
arg -c
filter [.[0] < .[1], .[1] < .[2], .[2] < .[3], .[0] == .[3], .[1] > .[0]]
stdin ["\\ufffd","\\ud83d\\ude00","😀\\u0000","\\ufffd"]\n
end

case compare/strings-escaped-and-raw
arg -c
filter [.[0] == .[1], .[0] < .[1], .[0] <= .[1], .[2] < .[0]]
stdin ["a\\u00e9b","aéb","a\\u00e9"]\n
end

# arrays element by element, then by length

case compare/arrays-element-wise-then-length
arg -c
filter [[1,2] < [1,3], [1,2] < [1,2,0], [2] > [1,9,9], [] < [null], [[1]] < [[1,0]], [] == [], [1,[2]] >= [1,[2]]]
stdin null\n
end

case compare/arrays-first-difference-decides
arg -c
filter [[1,"a"] < [2,null], ["b",0] > ["a",9], [null,true] < [false]]
stdin null\n
end

case compare/arrays-from-the-document
arg -c
filter [.[0] < .[1], .[1] < .[2], .[2] > .[3], .[3] == .[3], .[0] < .[0]]
stdin [[1,2],[1,3],[1,3,0],[[1]]]\n
end

# objects by their sorted key lists, then their values in sorted-key order

case compare/objects-keys-first
arg -c
filter [{"b":1} > {"a":2}, {"a":1} < {"a":1,"b":0}, {"a":1,"b":2} < {"a":1,"c":0}, {} < {"a":null}, {"b":0} > {"a":9,"c":9}]
stdin null\n
end

case compare/objects-values-in-sorted-key-order
arg -c
filter [{"b":1,"a":2} > {"a":1,"b":2}, {"b":2,"a":1} < {"a":1,"b":3}, {"a":[1],"b":0} == {"b":0,"a":[1]}]
stdin null\n
end

case compare/objects-key-bytes
arg -c
filter [{"\\u0080":0} > {"z":0}, {"\\ufffd":0} < {"\\ud83d\\ude00":0}, {"aa":0} > {"a":0,"b":0}]
stdin null\n
end

case compare/objects-from-the-document
arg -c
filter [.[0] > .[1], .[1] < .[2], .[2] < .[3], .[0] == .[0], .[3] > .[1]]
stdin [{"b":1,"a":2},{"a":1,"b":2},{"a":1,"b":2,"c":0},{"b":0}]\n
end

case compare/objects-built-and-read
arg -c
filter [{b:.b, a:.a} == ., {a:.a, b:1} < ., {a:.a, b:.b, c:null} > .]
stdin {"a":1,"b":2}\n
end

# numbers through the operators (#65's three-way compare, ADR-0012, ADR-0037)

case compare/numbers
arg -c
filter [1 < 1.0, 1 == 1.0, -0 == 0, -0 < 0, 1e1000 > 1e999, 100000000000000000001 > 100000000000000000000, 1.000 == 1, 0.1 < 0.2]
stdin null\n
end

case compare/numbers-from-the-document
arg -c
filter [.[0] < .[1], .[1] == .[2], .[3] > .[0], .[4] < .[0]]
stdin [100000000000000000000,100000000000000000001,1.00000000000000000001e20,1e1000,-1e1000]\n
end

# NaN is read as null against a number (ADR-0037); against another kind it is a number. NaN rows are #72's (O4).

case compare/nan-read-as-null
arg -c
filter (1e1000 - 1e1000) | [. < 1, . > null, . < null, . == ., . < ., . > -1e1000, . < false, . < "a"]
stdin null\n
end

case compare/nan-in-an-array
arg -c
filter (1e1000 - 1e1000) as $n | [[$n] < [0], [0] > [$n], [$n] < [$n], [$n, 1] < [null, 0]]
stdin null\n
end

# folding: a comparison of two constants folds as jq's constant_fold does, so a constant non-string key is a
# parse-time error (rc 3); and, or, // and not are not folded and fail at run time (rc 5)

case compare/key-folded-less
arg -c
filter {(1<2):1}
stdin null\n
end

case compare/key-folded-not-equal
arg -c
filter {(1 != 1):1}
stdin null\n
end

case compare/key-folded-greater
arg -c
filter {(1 > 2):1}
stdin null\n
end

case compare/key-folded-less-or-equal
arg -c
filter {(1 <= 2):1}
stdin null\n
end

case compare/key-folded-greater-or-equal
arg -c
filter {(1 >= 2):1}
stdin null\n
end

case compare/key-folded-equal
arg -c
filter {(1==1):1}
stdin null\n
end

case compare/key-folded-strings
arg -c
filter {("a"<"b"):1}
stdin null\n
end

case compare/key-folded-containers
arg -c
filter {([1] < [2]):1}
stdin null\n
end

case compare/key-folded-objects
arg -c
filter {({} == {}):1}
stdin null\n
end

case compare/key-folded-nulls
arg -c
filter {(null == null):1}
stdin null\n
end

case compare/key-folded-nested
arg -c
filter {((1 < 2) == true):1}
stdin null\n
end

case compare/key-not-folded-and
arg -c
filter {(true and true):1}
stdin null\n
end

case compare/key-not-folded-or
arg -c
filter {(false or true):1}
stdin null\n
end

case compare/key-not-folded-alternative
arg -c
filter {(null // 1):1}
stdin null\n
end

case compare/key-not-folded-alternative-constants
arg -c
filter {(1 // 2):1}
stdin null\n
end

case compare/key-not-folded-comparison-and
arg -c
filter {(1 < 2 and true):1}
stdin null\n
end

case compare/key-not-folded-dot
arg -c
filter {(. < 2):1}
stdin null\n
end

case compare/key-not-folded-not
arg -c
filter {("a" < "b" | not):1}
stdin null\n
end

case compare/key-not-folded-field
arg -c
filter {(.a < 2):1}
stdin {"a":1}\n
end
