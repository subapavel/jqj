# Differential cases (ADR-0020) of fields, chains, pipe, parentheses and the error line (#34); format:
# oracle/src/main/java/io/github/subapavel/jqj/oracle/diff/DiffCase.java. Expected outputs live in field.rec, written by
# scripts/oracle-record.sh only. Ids are immutable. Every case uses -c: pretty output is a Stub until #39.

# hit / miss: .a on {"a":<kind>}, a missing key, an empty object, null.

case field/hit-null
arg -c
filter .a
stdin {"a":null}\n
end

case field/hit-true
arg -c
filter .a
stdin {"a":true}\n
end

case field/hit-false
arg -c
filter .a
stdin {"a":false}\n
end

case field/hit-number
arg -c
filter .a
stdin {"a":42}\n
end

case field/hit-string
arg -c
filter .a
stdin {"a":"x y"}\n
end

case field/hit-array
arg -c
filter .a
stdin {"a":[1,[2],{}]}\n
end

case field/hit-object
arg -c
filter .a
stdin {"b":0,"a":{"b":{},"c":[]}}\n
end

case field/miss-key
arg -c
filter .a
stdin {"b":1}\n
end

case field/miss-empty
arg -c
filter .a
stdin {}\n
end

case field/null-input
arg -c
filter .a
stdin null\n
end

# duplicates: the last value wins, at the first key's position (ADR-0002).

case field/duplicate-dot
arg -c
filter .
stdin {"a":1,"b":2,"a":3}\n
end

case field/duplicate-field
arg -c
filter .a
stdin {"a":1,"b":2,"a":3}\n
end

case field/duplicate-nested
arg -c
filter .a.b
stdin {"a":{"b":1},"a":{"c":2}}\n
end

# structure: chains, |, parentheses and the whitespace between steps.

case field/chain-3
arg -c
filter .a.b.c
stdin {"a":{"b":{"c":"x"}}}\n
end

case field/chain-null-middle
arg -c
filter .a.b.c
stdin {"a":{}}\n
end

case field/chain-error-middle
arg -c
filter .a.b.c
stdin {"a":{"b":5}}\n
end

case field/pipe
arg -c
filter .a | .b
stdin {"a":{"b":1}}\n
end

case field/pipe-3
arg -c
filter .a|.b|.c
stdin {"a":{"b":{"c":[true]}}}\n
end

case field/pipe-identity
arg -c
filter . | .a | .
stdin {"a":{"b":2}}\n
end

case field/parens
arg -c
filter (.a)
stdin {"a":"p"}\n
end

case field/parens-postfix
arg -c
filter (.a).b
stdin {"a":{"b":"q"}}\n
end

case field/parens-pipe
arg -c
filter (.a | .b).c
stdin {"a":{"b":{"c":3}}}\n
end

case field/parens-nested
arg -c
filter ((.a))
stdin {"a":[4]}\n
end

case field/space-steps
arg -c
filter .a .b
stdin {"a":{"b":5}}\n
end

case field/dot-space-field
arg -c
filter . .a
stdin {"a":6}\n
end

# names: keywords after a dot are plain names.

case field/keyword-and
arg -c
filter .and
stdin {"and":1}\n
end

case field/keyword-if
arg -c
filter .if
stdin {"if":2}\n
end

case field/keyword-loc
arg -c
filter .__loc__
stdin {"__loc__":3}\n
end

case field/keyword-chain
arg -c
filter .then.else.end.or.reduce.def
stdin {"then":{"else":{"end":{"or":{"reduce":{"def":"k"}}}}}}\n
end

case field/name-chars
arg -c
filter ._1.A9
stdin {"_1":{"A9":true}}\n
end

# errors, rc 5: .a on each non-object kind; names of 24 to 30 bytes in the message; a file argument's name.

case field/error-array
arg -c
filter .a
stdin [1]\n
end

case field/error-string
arg -c
filter .a
stdin "s"\n
end

case field/error-number
arg -c
filter .a
stdin 5\n
end

case field/error-true
arg -c
filter .a
stdin true\n
end

case field/error-false
arg -c
filter .a
stdin false\n
end

case field/error-name-24
arg -c
filter .abcdefghijklmnopqrstuvwx
stdin [1]\n
end

case field/error-name-25
arg -c
filter .abcdefghijklmnopqrstuvwxy
stdin [1]\n
end

case field/error-name-27
arg -c
filter .abcdefghijklmnopqrstuvwxyz0
stdin [1]\n
end

case field/error-name-28
arg -c
filter .abcdefghijklmnopqrstuvwxyz01
stdin [1]\n
end

case field/error-name-29
arg -c
filter .abcdefghijklmnopqrstuvwxyz012
stdin [1]\n
end

case field/error-name-30
arg -c
filter .abcdefghijklmnopqrstuvwxyz0123
stdin [1]\n
end

case field/error-file-argument
arg -c
filter .a
arg in.json
file in.json [1]\n
end

# N of (at <stdin>:N): the read blocks that end in LF, up to the block holding the completing byte (GLOSSARY, F-25).

case field/line-no-lf
arg -c
filter .a
stdin [1]
end

case field/line-lf
arg -c
filter .a
stdin [1]\n
end

case field/line-inner-lfs
arg -c
filter .a
stdin [\n1\n]
end

case field/line-trailing-lfs
arg -c
filter .a
stdin [1]\n\n\n
end

case field/line-leading-lfs
arg -c
filter .a
stdin \n\n[1]
end

case field/line-crlf
arg -c
filter .a
stdin \x0d\n[\x0d\n1]\x0d\n
end

case field/line-number-eof
arg -c
filter .a
stdin 1
end

# The 4091-byte cut. A read block is the bytes through the next LF, or 4091 bytes plus the rest of a UTF-8
# character cut there; B below is a 1-based byte position of stdin.

# ] at B4091, then LF at B4092: [ " 4087 x " ] LF.
case field/line-cut-before
arg -c
filter .a
stdin [""]\n
end

# ] at B4092, then LF at B4093: [ " 4088 x " ] LF.
case field/line-cut-after
arg -c
filter .a
stdin [""]\n
end

# 1 at B4091, then LF at B4092: 4090 spaces, 1, LF.
case field/line-number-late
arg -c
filter .a
stdin                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           1\n
end

# true at B4088..B4091, then LF at B4092: 4087 spaces, true, LF.
case field/line-literal-late
arg -c
filter .a
stdin                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        true\n
end

# closing quote at B4091, then LF at B4092: " 4089 x " LF.
case field/line-string-cut
arg -c
filter .a
stdin ""\n
end

# U+00E9 (C3 A9) at B4091..B4092, so the first block takes 4092 bytes; ] at B8183, then LF at B8184: [ " 4088 x, U+00E9, 4089 x " ] LF.
case field/line-utf8-cut
arg -c
filter .a
stdin ["é"]\n
end
